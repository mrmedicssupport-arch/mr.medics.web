{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["patient", "doctor", "pharmacist", "lab", "admin"] },
        "status": { "type": "string", "enum": ["Active", "Pending", "Suspended", "Blocked"] }
      },
      "required": ["uid", "email", "role", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles"
    }
  }
}
